{
    "layer": "top",
    "position": "top",
    "height": 42,
    "spacing": 4,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "custom/mpris",
        "custom/tex",
        "custom/tw"
    ],
    "modules-right": [
        "idle_inhibitor",
        "custom/info-docker",
        "backlight",
        "pulseaudio",
        "disk",
        "memory",
        "cpu",
        "network",
        "temperature",
        "clock",
        "battery",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": false,
        "disable-scroll-wraparound": true,
        "enable-bar-scroll": true,
        "all-outputs": false,
        "format": "{index}",
        "tooltip": false
    },
    "sway/mode": {
        "format": " {}",
        "tooltip": false
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "clock": {
        "format": "{:%d/%m  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "cpu": {
        "interval": 2,
        "tooltip": false,
        "format": " {usage}%",
        "states": {
            "warning": 90
        },
        "on-click": "gnome-system-monitor"
    },
    "memory": {
        "interval": 2,
        "tooltip": false,
        "format": "󰍛 {avail:0.1f}G",
        "states": {
            "warning": 80
        },
        "on-click": "gnome-system-monitor"
    },
    "disk": {
        "interval": 30,
        "format": " {free}",
        "path": "/",
        "tooltip": false,
        "on-click": "alacritty -e ncdu"
    },
    "temperature": {
        "thermal-zone": 0,
        "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
        "critical-threshold": 80,
        "interval": 5,
        "tooltip": false,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },
    "network": {
        "interval": 3,
        "tooltip": false,
        "format-wifi": "  {essid}",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": "",
        "on-click": "alacritty -e nmtui"
    },
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃛",
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟",
            "󰃠",
            "󰃡",
            "󰃢"
        ],
        "tooltip": false,
        "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +5%",
        "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 5%-"
    },
    "pulseaudio": {
        "tooltip": false,
        "scroll-step": 1,
        "format": " {volume}%",
        "format-bluetooth": " {volume}%",
        "format-muted": "󰝟",
        "on-click": "pavucontrol"
    },
    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "full-at": 98,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-full": " {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "tooltip-format": "{timeTo}",
        "on-click": "xfce4-power-manager-settings"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": false
    },
    "custom/info-docker": {
        "exec": "~/.i3/scripts/info-docker.sh",
        "interval": 60,
        "format": "󰡨 {}",
        "tooltip": false
    },
    "custom/mpris": {
        "exec": "~/.i3/scripts/player-mpris-tail.py -f '{icon} {:artist:t30:{artist}:}{:artist: - :}{:t30:{title}:}'",
        "tail": true,
        "format": "󰽰 {}",
        "on-click": "~/.i3/scripts/player-mpris-tail.py play-pause",
        "tooltip": false
    },
    "custom/tw": {
        "exec": "task due.before:eow project.not:media status:pending count",
        "interval": 600,
        "format": " {}",
        "tooltip": false
    },
    "custom/tex": {
        "exec": "wc -w ~/repos/thesis/total.md | awk '{print $1}'",
        "interval": 600,
        "format": "WORDS: {}",
        "tooltip": false
    }
}