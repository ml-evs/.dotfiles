# kanshi — autorandr equivalent for Wayland/sway.
# Profiles match on connected outputs; the first matching profile wins.
# Reload via: systemctl --user restart kanshi  (or pkill -HUP kanshi).

profile home {
    # Gigabyte ultrawide native, laptop centered below.
    # Laptop X = (5120 - 1920) / 2 = 1600; Y = 1440 (ultrawide height).
    output DP-2 mode 5120x1440@144Hz position 0,0 scale 1
    output eDP-1 mode 1920x1200@60Hz position 1600,1440 scale 1
}

profile work {
    # Dell ultrawide on the left, laptop to the right.
    output "Dell Inc. DELL P3425WE *" mode 3440x1440@60Hz position 0,0 scale 1
    output eDP-1 mode 1920x1200@60Hz position 3440,0 scale 1
}

# No separate "docked" profile: it would list the same outputs as `home`
# (ultrawide + eDP-1) and kanshi picks the first match, so it could never be
# selected. When docked with the lid shut, sway's lid bindswitch disables
# eDP-1 instead (see `bindswitch lid:on output $laptop disable` in sway).

profile laptop {
    # Undocked: only eDP-1 is connected. Do NOT name the external here —
    # kanshi requires every output a profile lists to be connected for the
    # profile to match, so naming the (absent) ultrawide made this profile
    # never match when undocked ("no profile matched"), leaving eDP-1
    # stranded at its docked position. List only outputs that are present.
    output eDP-1 mode 1920x1200@60Hz position 0,0 scale 1
}
